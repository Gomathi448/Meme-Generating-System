{
  "project": "Automated Intelligent Meme Generating System",
  "version": "1.0.0",
  "basePath": "/api/v1",
  "endpoints": {
    "auth": {
      "register": {
        "path": "/auth/register",
        "method": "POST",
        "request": {
          "email": "string (EmailStr)",
          "username": "string (min: 3, max: 50)",
          "password": "string (min: 6)",
          "role": "string (USER, ADMIN) [optional]"
        },
        "response": {
          "id": "integer",
          "email": "string",
          "username": "string",
          "role": "string",
          "avatar_url": "string (null)",
          "is_active": "boolean",
          "created_at": "datetime"
        }
      },
      "login": {
        "path": "/auth/login",
        "method": "POST",
        "request": {
          "username": "string",
          "password": "string"
        },
        "response": {
          "access_token": "string",
          "refresh_token": "string",
          "token_type": "string",
          "role": "string",
          "username": "string",
          "id": "integer"
        }
      }
    },
    "memes": {
      "generate_captions": {
        "path": "/memes/generate-captions",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer <JWT>"
        },
        "request": {
          "prompt": "string",
          "tone": "string (sarcastic, wholesome, dark, corporate)",
          "language": "string (en, es, fr)"
        },
        "response": {
          "prompt": "string",
          "tone": "string",
          "variants": [
            {
              "top_text": "string",
              "bottom_text": "string",
              "sentiment_score": "float (-1.0 to 1.0)",
              "humor_score": "float (0.0 to 100.0)",
              "virality_score": "float (0.0 to 100.0)",
              "explanation": "string"
            }
          ]
        }
      },
      "generate": {
        "path": "/memes/generate",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer <JWT>"
        },
        "request": {
          "title": "string",
          "top_text": "string",
          "bottom_text": "string",
          "tone": "string",
          "tags": "string",
          "template_id": "integer [optional]",
          "image_data_url": "string (base64) [optional]",
          "status": "string (PUBLISHED, DRAFT, SCHEDULED)",
          "scheduled_for": "datetime (null)"
        },
        "response": {
          "id": "integer",
          "creator_id": "integer",
          "creator_username": "string",
          "title": "string",
          "image_url": "string",
          "top_text": "string",
          "bottom_text": "string",
          "tone": "string",
          "sentiment_score": "float",
          "humor_score": "float",
          "virality_score": "float",
          "likes_count": "integer",
          "comments_count": "integer",
          "created_at": "datetime"
        }
      }
    }
  }
}
